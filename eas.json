{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_FEED_URL": "https://raw.githubusercontent.com/nimenoz/hearthledger/main/data/feed.json"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FEED_URL": "https://raw.githubusercontent.com/nimenoz/hearthledger/main/data/feed.json"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FEED_URL": "https://raw.githubusercontent.com/nimenoz/hearthledger/main/data/feed.json"
      }
    }
  }
}
